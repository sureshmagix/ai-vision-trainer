# ==============================================================================
# AI Vision Trainer — Environment Configuration Template
# Copy this file to .env and adjust variables as required for your environment.
# ==============================================================================

# System Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# Application Metadata
APP_NAME="AI Vision Trainer"
APP_VERSION="1.0.0"

# Backend API Configuration
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=change-me-in-production-use-a-secure-random-32-char-string
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Database Configuration (PostgreSQL)
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://vision_user:vision_password@localhost:5432/ai_vision_trainer
# Fallback / sync URL for migrations (Alembic)
DATABASE_SYNC_URL=postgresql://vision_user:vision_password@localhost:5432/ai_vision_trainer

# Redis & Durable Queue Broker
REDIS_URL=redis://localhost:6379/0

# Storage Locations (Paths on local disk or mounted persistent volume)
STORAGE_ROOT=./storage
DATASET_STORAGE_PATH=./storage/datasets
MODEL_STORAGE_PATH=./storage/models
ARTIFACT_STORAGE_PATH=./storage/artifacts
UPLOAD_TEMP_PATH=./storage/temp_uploads

# Worker & Hardware
WORKER_CONCURRENCY=2
ACCELERATOR_DEVICE=auto   # 'auto', 'cuda', 'mps', or 'cpu'
MAX_WORKER_MEMORY_MB=16384

# Observability (MLflow & FiftyOne)
MLFLOW_TRACKING_URI=http://localhost:5000
FIFTYONE_DEFAULT_APP_PORT=5151

# Frontend Configuration (Vite)
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
